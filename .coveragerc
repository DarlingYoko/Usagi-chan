[run]
source = usagiBot
omit =
    */tests/*

[report]
show_missing = True
# Floor kept a few points under the current ~53% source-only baseline so
# routine churn doesn't flake CI, while still blocking real regressions.
# Raise it as the Music monolith (the bulk of the uncovered lines) gets
# split and tested — see REFACTOR_PLAN.md / IMPROVEMENT_PLAN.md Phase 5.
fail_under = 50
